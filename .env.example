# ---------------------------------------------------------------------------
# LibreNMS API
# ---------------------------------------------------------------------------
# Base URL of your LibreNMS instance (no trailing /api/v0).
LIBRENMS_URL=https://librenms.example.com

# API token from https://<librenms>/users (User -> API Access).
LIBRENMS_TOKEN=replace-me

# ---------------------------------------------------------------------------
# Report scoping
# ---------------------------------------------------------------------------
# Label printed in the report header. Purely cosmetic — does NOT filter alerts.
PROJECT_GROUP=WARP

# LibreNMS alert state to include:
#   0 = recovered/ok   1 = active   2 = acknowledged
ALERT_STATE=1

# Optional severity filter: critical | warning | ok. Empty = all.
ALERT_SEVERITY=

# ---------------------------------------------------------------------------
# SSL certificate check for LIBRENMS_URL
# ---------------------------------------------------------------------------
# Certificates are renewed by hand through ssl-manager, so the report has to
# nag early enough for someone to act. Only runs when LIBRENMS_URL is https.
# 1 = check (default), 0 = skip
SSL_CHECK=1

# First warning threshold in days (⚠️  section in the report).
SSL_WARN_DAYS=14

# Escalation threshold in days (🚨 section in the report).
SSL_CRIT_DAYS=7

# Seconds to wait for the TLS handshake (needs `timeout`/`gtimeout`; ignored
# when neither is installed).
SSL_TIMEOUT=10

# Action line printed under the expiry warning.
SSL_MANAGER_HINT=Manual renewal required via ssl-manager

# ---------------------------------------------------------------------------
# Signal — signal-cli-rest-api (https://github.com/bbernhard/signal-cli-rest-api)
# ---------------------------------------------------------------------------
# You must self-host signal-cli-rest-api and register SIGNAL_SENDER with it
# before this script can deliver anything.
SIGNAL_API_URL=https://signal.example.com
SIGNAL_API_USER=admin
SIGNAL_API_PASS=replace-me

# Phone number registered in signal-cli (E.164). Will appear as the sender.
SIGNAL_SENDER=+421900000000

# Recipient. Prefer a group ID — direct phone numbers must be in the bot's
# contacts (i.e. the recipient has messaged the bot at least once).
# Look up groups: curl -u $SIGNAL_API_USER:$SIGNAL_API_PASS \
#   $SIGNAL_API_URL/v1/groups/$SIGNAL_SENDER
SIGNAL_RECIPIENT=group.RXhhbXBsZUdyb3VwSWQ=
# SIGNAL_RECIPIENT=+421900000001

# ---------------------------------------------------------------------------
# Runtime flags (optional; pass on the command line)
# ---------------------------------------------------------------------------
# DRY_RUN=1 ./noc-report.sh   — print the report but skip the Signal send
